# ─────────────────────────────────────────────
# API Keys
# Comma-separated list of valid API keys.
# Each consumer of this service should have its own key so individual keys
# can be revoked without affecting other consumers.
# Generate a key with: openssl rand -hex 32
# ─────────────────────────────────────────────
API_KEYS=key_replace_me_1,key_replace_me_2

# ─────────────────────────────────────────────
# Rate Limiting
# Maximum number of requests allowed per key within the time window.
# ─────────────────────────────────────────────
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# ─────────────────────────────────────────────
# File Upload Limits
# Maximum allowed PDF upload size in bytes.
# Leave empty for no application-level limit (server hard cap still applies).
# Examples: 10485760 (10 MB), 52428800 (50 MB)
# ─────────────────────────────────────────────
MAX_FILE_SIZE=

# ─────────────────────────────────────────────
# Nuxt
# ─────────────────────────────────────────────
NUXT_PUBLIC_SITE_URL=http://localhost:3000
